[Unit]
Description=PRISM live (pre-registered D2 on RIPE RIS Live)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/prism-bgp/code
ExecStart=/usr/bin/python3 live_prism.py --out live_out
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
